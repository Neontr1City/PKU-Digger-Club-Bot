[Unit]
Description=Bounded compressed swap cache for the small Digger Club VM
ConditionPathExists=/sys/module/zswap/parameters/enabled
Before=docker.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo 20 > /sys/module/zswap/parameters/max_pool_percent; echo 1 > /sys/module/zswap/parameters/enabled'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
