SECRET_KEY=replace-with-a-long-random-value
ADMIN_PASSWORD=replace-with-a-private-password
DATABASE=data/cricket.sqlite3
OUTPUT_DIR=output
PUBLIC_BASE_URL=http://127.0.0.1:5057
# Set to 1 only for an isolated demo database. Never enable for the real group.
DEMO_MODE=0
# Optional path to a CJK TrueType/OpenType font for result images.
RESULT_FONT=

# QQ email notifications: disabled until configured. SMTP SSL on smtp.qq.com:465.
ADMIN_EMAIL_ENABLED=0
QQ_SMTP_EMAIL=
# Dedicated SMTP authorization code, NOT the QQ login password.
QQ_SMTP_AUTH_CODE=
# Leave blank to send to the same QQ mailbox.
ADMIN_EMAIL_TO=
